# Solo desarrollo local. Cambiar ambos valores antes de iniciar.
POSTGRES_PASSWORD=cambiar_esta_clave_local
MOODLE_ADMIN_PASSWORD=CambiarEstaClave123!
MOODLE_URL=http://localhost:8080
# Usuarios ficticios docente.demo y estudiante.demo (solo desarrollo; vacío = no se crean).
MOODLE_DEMO_PASSWORD=Demo.Aula.ET37!
# Correo saliente. En desarrollo Mailpit lo captura en http://localhost:8025.
MOODLE_SMTP_HOST=mail:1025
# Google OAuth 2 (opcional). Crear credenciales "Aplicación web" en Google Cloud Console con
# URI de redirección http://localhost:8080/admin/oauth2callback.php. No subir valores reales a Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dominios permitidos separados por coma (ej. et37ba.edu.ar). Vacío = cualquier cuenta de Google.
GOOGLE_ALLOWED_DOMAINS=
# GitHub OAuth 2 (opcional): "Acceder con GitHub" y vincular la cuenta desde Preferencias.
# Crear una OAuth App en GitHub > Settings > Developer settings con callback
# http://localhost:8080/admin/oauth2callback.php. Solo funciona con cuentas de GitHub con correo público.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 1 = exigir segundo factor (app TOTP) a administradores y directivos. Recomendado en producción.
MOODLE_MFA=
# Servidor Jobe para CodeRunner (servicio interno de compose).
JOBE_HOST=jobe

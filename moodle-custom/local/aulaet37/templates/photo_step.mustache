{{!
    @template local_aulaet37/photo_step

    Profile photo step shown after the first login of self-registered accounts.

    Example context (json):
    {
        "fullname": "Ana Pérez",
        "required": true,
        "form": "<form></form>",
        "logouturl": "https://example.invalid/login/logout.php",
        "profileurl": "https://example.invalid/user/profile.php"
    }
}}
<div class="et37-step">
    <p class="et37-step-kicker">{{#str}}photostepkicker, local_aulaet37{{/str}}</p>
    <h1 class="h2">{{#str}}photostep, local_aulaet37{{/str}}</h1>
    <p class="text-muted">{{#str}}photostepintro, local_aulaet37, {{fullname}}{{/str}}</p>
    <ul class="et37-step-tips">
        <li>{{#str}}photosteptip1, local_aulaet37{{/str}}</li>
        <li>{{#str}}photosteptip2, local_aulaet37{{/str}}</li>
        <li>{{#str}}photosteptip3, local_aulaet37{{/str}}</li>
    </ul>
    {{{form}}}
    <p class="small text-center mt-4 mb-0">
        {{#required}}
            <a href="{{logouturl}}">{{#str}}logout{{/str}}</a>
        {{/required}}
        {{^required}}
            <a href="{{profileurl}}">{{#str}}viewprofile{{/str}}</a>
        {{/required}}
    </p>
</div>

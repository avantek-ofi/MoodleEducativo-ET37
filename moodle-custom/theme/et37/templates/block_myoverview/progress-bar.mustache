{{!
    @template block_myoverview/progress-bar

    Course progress from Moodle completion data: the text from core plus a visual
    bar. The bar is decorative because the text already states the value.

    Example context (json):
    {
        "progress": 50
    }
}}
<div class="et37-progress">
    <div class="progress" aria-hidden="true">
        <div class="progress-bar" style="width: {{progress}}%"></div>
    </div>
    <div class="progress-text">
        <span class="visually-hidden">{{#str}}aria:courseprogress, block_myoverview{{/str}}</span>
        {{#str}}completepercent, block_myoverview, <span>{{progress}}</span>{{/str}}
    </div>
</div>

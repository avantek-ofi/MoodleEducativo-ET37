{{!
    @template theme_et37/dashboard_quicklinks

    Date and shortcuts to native Moodle pages, shown in the dashboard header.

    Example context (json):
    {
        "today": "lunes, 10 de noviembre de 2026",
        "links": [
            {"url": "https://example.invalid/my/courses.php", "label": "Mis cursos", "icon": "i/course", "tone": "violet"}
        ]
    }
}}
<p class="et37-today">{{today}}</p>
<nav class="et37-quicklinks" aria-label="{{#str}}quicklinks, theme_et37{{/str}}">
    <ul>
        {{#links}}
            <li>
                <a class="et37-quicklink et37-tone-{{tone}}" href="{{url}}">
                    <span class="et37-quicklink-icon" aria-hidden="true">{{#pix}}{{icon}}, core{{/pix}}</span>
                    <span>{{label}}</span>
                </a>
            </li>
        {{/links}}
    </ul>
</nav>
